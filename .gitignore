# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# ─── Virtual Environments ───
venv/
venv*/
env/
.venv/
audio_cutter/
.env

# ─── Uploads & Processed files (NEVER commit user media) ───
uploads/
!uploads/.gitkeep
processed/
!processed/.gitkeep
logs/
!logs/.gitkeep

# ─── Downloaded Models (Whisper, Super-Res, TTS, Demucs) ───
models/
!models/.gitkeep

# ─── Projects (personal studio saves) ───
projects/
!projects/.gitkeep

# ─── Copilot Memory & user data ───
data/
memory/
user_skills/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

